use 5.016;
use warnings;

use Test::More;

use lib 'tools/lib';

use Twilio::Generator::TwiML;
use Twilio::TwiML::TwiML;

my %ELEMENT = (
  tag            => 'Thing',
  value          => 'words',
  has_attributes => 1,
  attributes     => [
    {
      name   => 'loud',
      wire   => 'isLoud',
      method => 'set_loud',
      type   => 'boolean',
      about  => 'Say it <loud>',
    },
    { name => 'tags', wire => 'tags', method => 'set_tags', type => 'list', about => 'Tags' },
    { name => 'mode', wire => 'mode', method => 'set_mode', type => 'text', about => 'Mode' },
  ],
  children => [
    {
      method         => 'part',
      class          => 'Demo::Part',
      value          => 'url',
      has_attributes => 1,
      about          => 'Add Part child.',
    },
    {
      method         => 'stop',
      class          => 'Demo::Stop',
      value          => undef,
      has_attributes => 0,
      about          => 'Add Stop child.',
    },
  ],
);

my %PART = (
  tag            => 'Part',
  value          => 'url',
  has_attributes => 1,
  attributes     => [],
  children       => [],
);
my %STOP =
  (tag => 'Stop', value => undef, has_attributes => 0, attributes => [], children => []);

subtest 'the file of each module' => sub {
  my $modules = Twilio::Generator::TwiML::modules({ 'Demo::Thing' => \%ELEMENT });

  is_deeply([keys %{$modules}], ['Twilio/TwiML/Demo/Thing.pm'], 'path');
};

my $code = sub {
  my ($name, $element) = @_;
  return Twilio::Generator::TwiML::module("Twilio::TwiML::$name", $name, $element);
};

compile($code->('Demo::Thing', \%ELEMENT));
compile($code->('Demo::Part',  \%PART));
compile($code->('Demo::Stop',  \%STOP));

subtest 'a generated element' => sub {
  my $thing = Twilio::TwiML::Demo::Thing->new('Hi', { loud => 1, tags => ['a', 'b'], mode => 'x' });
  isa_ok($thing, 'Twilio::TwiML::TwiML');
  like($thing->as_xml, qr/<Thing isLoud="true" mode="x" tags="a b">Hi<\/Thing>/, 'its document');
};

subtest 'the real name works too' => sub {
  my $thing = Twilio::TwiML::Demo::Thing->new('Hi', { isLoud => 0 });
  like($thing->as_xml, qr/isLoud="false"/, 'still a boolean');
};

subtest 'setters' => sub {
  my $thing = Twilio::TwiML::Demo::Thing->new('Hi');

  is($thing->set_mode('x'), $thing, 'they return the element');
  $thing->set_loud(1);
  like($thing->as_xml, qr/isLoud="true" mode="x"/, 'written');
};

subtest 'children' => sub {
  my $thing = Twilio::TwiML::Demo::Thing->new('Hi');

  my $part = $thing->part('/url', { any => 1 });
  isa_ok($part,        'Twilio::TwiML::Demo::Part');
  isa_ok($thing->stop, 'Twilio::TwiML::Demo::Stop');
  like($thing->as_xml, qr/<Part any="1">\/url<\/Part><Stop\/>/, 'written in order');
};

subtest 'the generated code' => sub {
  my $thing = $code->('Demo::Thing', \%ELEMENT);
  my $stop  = $code->('Demo::Stop',  \%STOP);

  like($thing, qr/\A# Generated by/,                   'says it is generated');
  like($thing, qr/require Twilio::TwiML::Demo::Part;/, 'loads a child when it is reached');
  like($thing, qr/'loud' => \{ name => 'isLoud', boolean => 1 \}/,   'the name in Perl');
  like($thing, qr/'isLoud' => \{ name => 'isLoud', boolean => 1 \}/, 'the real name');
  unlike($thing, qr/'mode' => .*\n\s*'mode' =>/, 'one entry when they are the same');
  like($thing, qr/SUPER::new\('Thing', \$words, \$attributes\)/, 'value and attributes');
  like($stop,  qr/SUPER::new\('Stop', undef\)/,                  'neither');
  unlike($stop, qr/%ATTRIBUTES/, 'no table with no attributes');

  my %with_verb = (%STOP, children => [{ method => 'record', class => 'X', about => q{} }]);
  like(
    $code->('Demo::Verb', \%with_verb),
    qr/sub record \{\s+## no critic/,
    'a verb critic dislikes'
  );
  unlike($thing, qr/sub part \{\s+## no critic/, 'and no others');
};

subtest 'the documentation' => sub {
  my $thing = $code->('Demo::Thing', \%ELEMENT);

  like($thing, qr/Demo::Thing - The Thing element/, 'name');
  like($thing, qr/=head2 attribute_table/,          'the table');
  ok(index($thing, "=head2 part\n\n  my \$child = \$element->part(\$url, \\%attributes);") >= 0,
    'a child');
  like($thing, qr/Add Part child[.] Returns a L<Twilio::TwiML::Demo::Part>/, 'and what it returns');
  like($thing, qr/=item C<loud>\n\nSay it E<lt>loudE<gt> True or false[.]/,  'a boolean, escaped');
  like($thing, qr/=item C<tags>\n\nTags An array reference[.]/,              'a list');
  like($thing, qr/=head2 set_mode/,                                          'a setter');
};

subtest 'names that cannot be used' => sub {
  my @cases = (
    [
      'a child',
      { %STOP, children => [{ method => 'append', class => 'X', about => q{} }] },
      qr/method append is reserved/,
    ],
    [
      'an attribute',
      {
        %STOP,
        attributes =>
          [{ name => 'nest', wire => 'nest', method => 'nest', type => 'text', about => q{} }]
      },
      qr/method nest is reserved/,
    ],
    [
      'twice',
      {
        %STOP,
        children => [
          { method => 'twin', class => 'X', about => q{} },
          { method => 'twin', class => 'X', about => q{} },
        ],
      },
      qr/two methods are called twin/,
    ],
  );

  for my $case (@cases) {
    my ($name, $element, $expected) = @{$case};
    my $ok    = eval { $code->('Demo::Bad', $element); 1 };
    my $error = $@;
    ok(!$ok, "$name: refused");
    like($error, $expected, "$name: says why");
  }
};

subtest 'a missing definition file' => sub {
  my $ok    = eval { Twilio::Generator::TwiML::load('tools/no-such-file.json'); 1 };
  my $error = $@;
  ok(!$ok, 'refused');
  like($error, qr/Cannot read/, 'says why');
};

done_testing;

sub compile {
  my ($source) = @_;

  my ($module) = $source =~ /^package (\S+);/m;
  no warnings 'redefine';                                           ## no critic (ProhibitNoWarnings)
  eval "$source; 1" or BAIL_OUT("$module does not compile: $@");    ## no critic (ProhibitStringyEval)

  my $file = ($module =~ s{::}{/}gr) . '.pm';
  $INC{$file} = 1;                                                  ## no critic (RequireLocalizedPunctuationVars)
  return;
}
