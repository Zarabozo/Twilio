severity = 3
verbose = %f:%l:%c [%p] %m\n
program-extensions = .pl .t

# Each resource keeps its list, context and instance packages in one .pm, which gives
# one POD page per resource instead of the five files PHP uses.
[-Modules::ProhibitMultiplePackages]

# Most patterns here are short URL and header matches, where /x adds nothing.
[-RegularExpressions::RequireExtendedFormatting]

# The object itself should not count. Generated methods take one argument for each part of a
# path and each required value, as in Twilio's libraries. Flex's Assessments takes ten required
# values and its options, as in twilio-php.
[Subroutines::ProhibitManyArgs]
skip_object = 1
max_arguments = 11

# One-line accessors are clearer without unpacking @_.
[Subroutines::RequireArgUnpacking]
short_subroutine_statements = 1

# Resources must offer the operations Twilio names: read, delete and next among them.
[-Subroutines::ProhibitBuiltinHomonyms]
